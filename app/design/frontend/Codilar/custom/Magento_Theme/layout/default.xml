<?xml version="1.0"?>

<page
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>

        <!-- Remove default top panel -->

        <referenceBlock
            name="header.panel"
            remove="true"
        />


        <!-- Top black header -->

        <referenceContainer name="header.panel.wrapper">

            <block
                class="Magento\Theme\Block\Html\Header"
                name="codilar.top.header"
                as="codilar_top_header"
                before="-"
                template="Magento_Theme::html/header.phtml"
            >

                <arguments>
                    <argument name="show_part" xsi:type="string">
                        welcome
                    </argument>
                </arguments>

            </block>

        </referenceContainer>


        <!-- Main header -->

        <referenceContainer name="header-wrapper">

            <!-- Navigation -->

            <container
                name="codilar-navigation"
                as="codilar_navigation"
                label="Codilar Navigation"
                htmlTag="div"
                htmlClass="codilar-navigation"
                before="-"
            />


            <!-- Header actions -->

            <container
                name="header.actions"
                as="header_actions"
                label="Header Actions"
                htmlTag="div"
                htmlClass="header-actions"
                after="codilar-navigation"
            />

        </referenceContainer>


        <!-- Account template -->

        <referenceBlock
            name="top.links"
            template="Magento_Customer::account/header-links.phtml"
        />


        <!-- Logo -->

        <move
            element="logo"
            destination="codilar-navigation"
            before="-"
        />


        <!-- Magento mega menu -->

        <move
            element="catalog.topnav"
            destination="codilar-navigation"
            after="logo"
        />


        <!-- Search -->

        <move
            element="top.search"
            destination="header.actions"
            before="-"
        />


        <!-- Account -->

        <move
            element="top.links"
            destination="header.actions"
            after="top.search"
        />


        <!-- Cart -->

        <move
            element="minicart"
            destination="header.actions"
            after="top.links"
        />

        <move
    element="cart.product.price"
    destination="cart.product.qty"
    after="-"/>

    </body>

</page>