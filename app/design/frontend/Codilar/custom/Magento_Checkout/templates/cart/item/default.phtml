<?php
/**
 * @var \Magento\Checkout\Block\Cart\Item\Renderer $block
 * @var \Magento\Framework\Escaper $escaper
 */

$_item = $block->getItem();
$product = $_item->getProduct();

$helper = $this->helper(\Magento\Msrp\Helper\Data::class);

$canApplyMsrp =
    $helper->isShowBeforeOrderConfirm($product)
    && $helper->isMinimalPriceLessMsrp($product);
?>

<div class="cart-product-card">

    <div class="cart-product-image">
        <?php if ($block->hasProductUrl()): ?>
            <a
                href="<?= $escaper->escapeUrl($block->getProductUrl()) ?>"
                title="<?= $escaper->escapeHtmlAttr($block->getProductName()) ?>"
                class="cart-product-image-link"
            >
                <?= $block->getImage(
                    $block->getProductForThumbnail(),
                    'cart_page_product_thumbnail'
                )->toHtml() ?>
            </a>
        <?php else: ?>
            <?= $block->getImage(
                $block->getProductForThumbnail(),
                'cart_page_product_thumbnail'
            )->toHtml() ?>
        <?php endif; ?>
    </div>

    <div class="cart-product-details">

        <div class="cart-product-name">
            <?php if ($block->hasProductUrl()): ?>
                <a href="<?= $escaper->escapeUrl($block->getProductUrl()) ?>">
                    <?= $escaper->escapeHtml($block->getProductName()) ?>
                </a>
            <?php else: ?>
                <?= $escaper->escapeHtml($block->getProductName()) ?>
            <?php endif; ?>
        </div>

        <?php if ($_options = $block->getOptionList()): ?>
            <div class="cart-product-options">
                <?php foreach ($_options as $_option): ?>
                    <?php $_formattedOptionValue = $block->getFormatedOptionValue($_option); ?>
                    <div class="cart-product-option">
                        <span class="option-label">
                            <?= $escaper->escapeHtml($_option['label']) ?>:
                        </span>
                        <span class="option-value">
                            <?php if (isset($_formattedOptionValue['full_view'])): ?>
                                <?= $escaper->escapeHtml($_formattedOptionValue['full_view'], ['span', 'a']) ?>
                            <?php else: ?>
                                <?= $escaper->escapeHtml($_formattedOptionValue['value'], ['span', 'a']) ?>
                            <?php endif; ?>
                        </span>
                    </div>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>

        <?php if ($messages = $block->getMessages()): ?>
            <div class="cart-product-messages">
                <?php foreach ($messages as $message): ?>
                    <div class="cart-product-message <?= $escaper->escapeHtmlAttr($message['type']) ?>">
                        <?= $escaper->escapeHtml($message['text']) ?>
                    </div>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>

        <?php $addInfoBlock = $block->getProductAdditionalInformationBlock(); ?>
        <?php if ($addInfoBlock): ?>
            <div class="cart-product-additional-info">
                <?= $addInfoBlock->setItem($_item)->toHtml() ?>
            </div>
        <?php endif; ?>

        <!-- Placed inside details container for clean responsive flow -->
        <div class="cart-product-qty">
            <button type="button" 
                    class="qty-btn qty-decrease" 
                    data-role="qty-decrease" 
                    aria-label="Decrease Qty">-</button>

            <input id="cart-<?= $block->escapeHtmlAttr($_item->getId()) ?>-qty"
                   name="cart[<?= $block->escapeHtmlAttr($_item->getId()) ?>][qty]"
                   value="<?= $block->escapeHtmlAttr($block->getQty()) ?>"
                   type="number"
                   size="4"
                   step="any"
                   title="<?= $block->escapeHtmlAttr(__('Qty')) ?>"
                   class="input-text qty"
                   data-role="cart-item-qty"
                   data-item-id="<?= $block->escapeHtmlAttr($_item->getId()) ?>"/>

            <button type="button" 
                    class="qty-btn qty-increase" 
                    data-role="qty-increase" 
                    aria-label="Increase Qty">+</button>
        </div>

    </div>

    <div class="cart-product-price">
        <?php if ($canApplyMsrp): ?>
            <span class="pricing msrp">
                <span class="msrp notice">
                    <?= $escaper->escapeHtml(__('See price before order confirmation.')) ?>
                </span>
                <?php $helpLinkId = 'cart-msrp-help-' . $_item->getId(); ?>
                <a
                    href="#"
                    class="action help map"
                    id="<?= $escaper->escapeHtmlAttr($helpLinkId) ?>"
                    data-mage-init='{
                        "addToCart": {
                            "origin": "info",
                            "helpLinkId": "#<?= $escaper->escapeJs($escaper->escapeHtml($helpLinkId)) ?>",
                            "productName": "<?= $escaper->escapeJs($escaper->escapeHtml($product->getName())) ?>",
                            "showAddToCart": false
                        }
                    }'
                >
                    <?= $escaper->escapeHtml(__("What's this?")) ?>
                </a>
            </span>
        <?php else: ?>
          <div class="cart-product-subtotal"
     data-role="cart-item-subtotal"
     data-item-id="<?= $escaper->escapeHtmlAttr($_item->getId()) ?>">
    <?= $block->getRowTotalHtml($_item) ?>
</div>
        <?php endif; ?>
    </div>

    <div class="cart-product-actions">
        <?= /* @noEscape */ $block->getActions($_item) ?>
    </div>

</div>