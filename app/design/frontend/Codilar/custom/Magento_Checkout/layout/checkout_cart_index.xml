<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>

        <referenceContainer name="content">

            <block
                class="Codilar\FreeShippingProgress\Block\Progress"
                name="codilar.free.shipping.progress"
                template="Codilar_FreeShippingProgress::progress.phtml"
                before="checkout.cart" />

        </referenceContainer>

        <referenceContainer name="cart.summary">

            <block
                class="Codilar\FreeShippingProgress\Block\Progress"
                name="codilar.free.shipping.success"
                template="Codilar_FreeShippingProgress::success-message.phtml"
                after="totals" />

        </referenceContainer>
 <referenceBlock name="page.main.title" remove="true"/>

        <!-- Order Summary title -->

        <referenceBlock name="checkout.cart.summary.title">
            <arguments>
                <argument name="text" xsi:type="string">
                    Order Summary
                </argument>
            </arguments>
        </referenceBlock>


        <!-- Cross sell -->

        <move
            element="checkout.cart.crosssell"
            destination="content"
            after="checkout.cart.container"
        />


        <!-- Discount -->

        <move
            element="checkout.cart.coupon"
            destination="cart.summary"
            after="checkout.cart.summary.title"
        />

    </body>

</page>