<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>

        <move element="product.info.addto" destination="product.info.main" before="-"/>

        <referenceBlock name="product.info.options.wrapper" remove="true"/>

        <referenceContainer name="content">
            <block class="Codilar\Suggestion\Block\RelatedCategoryProducts" name="codilar.suggestion.related.category.products" template="Codilar_Suggestion::product/related_category_products.phtml" after="-"/>
        </referenceContainer>

        <move element="product.info.details" destination="product.info.main" after="-"/>

        <referenceBlock name="view.addto.compare" remove="true"/>

        <referenceContainer name="product.info.main">
            <block class="Magento\Catalog\Block\Product\View" name="codilar.product.category.name" template="Magento_Catalog::product/view/category-name.phtml" before="-" />
        </referenceContainer>
        <move element="product.info.sku" destination="product.info.main" after="codilar.product.category.name"/>

    </body>
</page>
