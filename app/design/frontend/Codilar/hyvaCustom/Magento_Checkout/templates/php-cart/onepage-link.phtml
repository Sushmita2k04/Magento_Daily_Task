<?php

use Magento\Checkout\Block\Onepage\Link;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var Link $block */

$checkoutUrl = $block->getUrl('hyvareactcheckout/reactcheckout');

?>

<?php if ($block->isPossibleOnepageCheckout()): ?>
    <a @click.prevent.stop="$dispatch('toggle-authentication',
        {url: '<?= $escaper->escapeHtmlAttr($escaper->escapeUrl($checkoutUrl)) ?>'});"
       href="<?= $escaper->escapeHtmlAttr($escaper->escapeUrl($checkoutUrl)) ?>"
       title="<?= $escaper->escapeHtmlAttr(__('Proceed to Checkout')) ?>"
       class="btn btn-primary btn-checkout w-full"
       id="checkout-link-button">
        <?= $escaper->escapeHtml(__('Proceed to Checkout')) ?>
    </a>
<?php endif ?>