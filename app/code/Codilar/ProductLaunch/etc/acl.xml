                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Codilar_ProductLaunch::config" title="Product Launches Section" sortOrder="80"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
