<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="codilar_product_launch" resource="default" engine="innodb" comment="Codilar Product Launch">
        <column xsi:type="int" name="launch_id" unsigned="true" nullable="false" identity="true" comment="Launch ID"/>
        <column xsi:type="varchar" name="title" nullable="false" length="255" comment="Title"/>
        <column xsi:type="varchar" name="url_key" nullable="false" length="255" comment="URL Key"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="true" comment="Catalog Product ID (NULL when product was deleted)"/>
        <column xsi:type="varchar" name="sku" nullable="true" length="64" comment="Product SKU snapshot"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="varchar" name="banner" nullable="true" length="255" comment="Banner image (relative to media/codilar/productlaunch)"/>
        <column xsi:type="datetime" name="start_at" nullable="false" comment="Start date-time (UTC)"/>
        <column xsi:type="datetime" name="end_at" nullable="true" comment="End date-time (UTC), optional"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Enabled flag"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="launch_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CODILAR_PRODUCT_LAUNCH_URL_KEY">
            <column name="url_key"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="CODILAR_PRODUCT_LAUNCH_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID" table="codilar_product_launch" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="CODILAR_PRODUCT_LAUNCH_START_AT_END_AT" indexType="btree">
            <column name="start_at"/>
            <column name="end_at"/>
        </index>
        <index referenceId="CODILAR_PRODUCT_LAUNCH_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
        <index referenceId="CODILAR_PRODUCT_LAUNCH_TITLE" indexType="fulltext">
            <column name="title"/>
        </index>
    </table>
    <table name="codilar_product_launch_store" resource="default" engine="innodb" comment="Product Launch To Store View Link (0 = all)">
        <column xsi:type="int" name="launch_id" unsigned="true" nullable="false" comment="Launch ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID (0 = all store views)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="launch_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="CODILAR_PRODUCT_LAUNCH_STORE_LAUNCH_ID_CODILAR_PRODUCT_LAUNCH_LAUNCH_ID" table="codilar_product_launch_store" column="launch_id" referenceTable="codilar_product_launch" referenceColumn="launch_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="CODILAR_PRODUCT_LAUNCH_STORE_STORE_ID_STORE_STORE_ID" table="codilar_product_launch_store" column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="CODILAR_PRODUCT_LAUNCH_STORE_STORE_ID" indexType="btree">
            <column name="store_id"/>
        </index>
    </table>
</schema>
