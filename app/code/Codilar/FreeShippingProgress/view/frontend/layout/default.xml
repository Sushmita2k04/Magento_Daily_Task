<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>

        <referenceBlock name="minicart">

            <arguments>

                <argument name="jsLayout" xsi:type="array">

                    <item name="components" xsi:type="array">

                        <item name="minicart_content" xsi:type="array">

                            <item name="children" xsi:type="array">

                                <item name="extra_info" xsi:type="array">

                                    <item name="children" xsi:type="array">

                                        <!-- Free Shipping Progress -->
                                        <item name="free_shipping_progress" xsi:type="array">

                                            <item name="component" xsi:type="string">
                                                Codilar_FreeShippingProgress/js/progress
                                            </item>

                                            <item name="rewards" xsi:type="array">

                                                <item name="0" xsi:type="array">
                                                    <item name="amount" xsi:type="number">500</item>
                                                    <item name="title" xsi:type="string">Free Delivery</item>
                                                    <item name="subtitle" xsi:type="string">Auto applied</item>
                                                    <item name="type" xsi:type="string">shipping</item>
                                                </item>

                                                <item name="1" xsi:type="array">
                                                    <item name="amount" xsi:type="number">750</item>
                                                    <item name="title" xsi:type="string">$50 OFF</item>
                                                    <item name="subtitle" xsi:type="string">View ›</item>
                                                    <item name="type" xsi:type="string">coupon</item>
                                                </item>

                                                <item name="2" xsi:type="array">
                                                    <item name="amount" xsi:type="number">1000</item>
                                                    <item name="title" xsi:type="string">$100 OFF</item>
                                                    <item name="subtitle" xsi:type="string">Coupon</item>
                                                    <item name="type" xsi:type="string">coupon</item>
                                                </item>

                                                <item name="3" xsi:type="array">
                                                    <item name="amount" xsi:type="number">1500</item>
                                                    <item name="title" xsi:type="string">$150 OFF</item>
                                                    <item name="subtitle" xsi:type="string">Coupon</item>
                                                    <item name="type" xsi:type="string">coupon</item>
                                                </item>

                                            </item>

                                            <item name="config" xsi:type="array">

                                                <item name="template" xsi:type="string">
                                                    Codilar_FreeShippingProgress/progress
                                                </item>

                                            </item>

                                        </item>


                                        <!-- Success Message -->
                                        <item name="success_message" xsi:type="array">

                                            <item name="component" xsi:type="string">
                                                Codilar_FreeShippingProgress/js/success-message
                                            </item>

                                            <item name="config" xsi:type="array">

                                                <item name="template" xsi:type="string">
                                                    Codilar_FreeShippingProgress/success-message
                                                </item>

                                            </item>

                                        </item>

                                    </item>

                                </item>

                            </item>

                        </item>

                    </item>

                </argument>

            </arguments>

        </referenceBlock>

    </body>

</page>