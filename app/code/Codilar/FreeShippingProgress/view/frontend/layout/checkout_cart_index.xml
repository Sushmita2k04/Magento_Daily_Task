<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>

        <referenceContainer name="content">

            <block
                class="Codilar\FreeShippingProgress\Block\Progress"
                name="codilar.free.shipping.progress"
                template="Codilar_FreeShippingProgress::progress.phtml"
                before="-" />

        </referenceContainer>

        <referenceContainer name="cart.summary">

            <block
                class="Codilar\FreeShippingProgress\Block\Progress"
                name="codilar.free.shipping.success"
                template="Codilar_FreeShippingProgress::success-message.phtml"
                after="totals" />

        </referenceContainer>

    </body>

</page>
