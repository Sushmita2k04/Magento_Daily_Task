<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="codilar_loyalty_expire_points" instance="Codilar\LoyaltyWallet\Cron\ExpirePoints" method="execute">
            <schedule>0 2 * * *</schedule>
        </job>
        <job name="codilar_loyalty_sweep" instance="Codilar\LoyaltyWallet\Cron\Sweep" method="execute">
            <schedule>30 2 * * *</schedule>
        </job>
    </group>
</config>
