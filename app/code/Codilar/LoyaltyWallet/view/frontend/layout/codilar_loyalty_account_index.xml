<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">Loyalty Points &amp; Wallet</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="codilar.loyalty.account"
                   template="Codilar_LoyaltyWallet::account/index.phtml" cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Codilar\LoyaltyWallet\ViewModel\Account</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
