<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Codilar\ProductEnquiry\Logger\Handler">
        <arguments>

            <argument name="stream" xsi:type="string">
                /var/www/html/var/log/product_enquiry.log
            </argument>

            <argument name="level" xsi:type="const">
                Monolog\Level::Debug
            </argument>

            <argument name="bubble" xsi:type="boolean">
                true
            </argument>

        </arguments>
    </type>

    <type name="Codilar\ProductEnquiry\Logger\Logger">
        <arguments>

            <argument name="name" xsi:type="string">
                ProductEnquiry
            </argument>

            <argument name="handlers" xsi:type="array">

                <item name="product_enquiry" xsi:type="object">
                    Codilar\ProductEnquiry\Logger\Handler
                </item>

            </argument>

        </arguments>
    </type>

</config>
